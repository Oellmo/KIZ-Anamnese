rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Security Primitives
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'stefanbareis@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Validation Blueprint for Case
    function isValidCase(data, docId) {
      return data.keys().hasAll(['id', 'ownerId', 'chiffre', 'updatedAt', 'createdAt', 'stammdaten']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 64 && data.id == docId &&
        data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
        data.chiffre is string && data.chiffre.size() > 0 && data.chiffre.size() <= 16 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.stammdaten is map;
    }

    // Connection testing endpoint
    match /test/connection {
      allow get: if true;
    }

    // Anamnese Cases Collection
    match /cases/{caseId} {
      // Single-document read: owner or admin
      allow get: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );

      // Secure list query: forced check on resource.data.ownerId
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );

      // Create case
      allow create: if isSignedIn() &&
        isValidId(caseId) &&
        incoming().ownerId == request.auth.uid &&
        isValidCase(incoming(), caseId);

      // Update case: owner or admin, immutable ownerId and createdAt
      allow update: if isSignedIn() &&
        isValidId(caseId) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        isValidCase(incoming(), caseId);

      // Delete case: owner or admin
      allow delete: if isSignedIn() &&
        isValidId(caseId) &&
        (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
